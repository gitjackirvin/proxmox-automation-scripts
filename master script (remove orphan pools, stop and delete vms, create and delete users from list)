# MODE SELECTION
###############################################
echo "Select mode:"
echo "1) Create users/pools/groups (TSV only)"
echo "2) Delete users/pools/groups (TSV only)"
echo "3) Remove orphan pools AND VMs by prefix"
read -p "Enter choice: " mode

case $mode in
    1) ACTION="create" ;;
    2) ACTION="delete" ;;
    3) ACTION="cleanup" ;;
    *) echo "Invalid choice"; exit 1 ;;
esac

echo ""
echo "Mode selected: $ACTION"
echo ""

###############################################
# PREFIX SELECTION FOR CREATE/DELETE
###############################################
prefix=""
if [[ "$ACTION" == "create" || "$ACTION" == "delete" ]]; then
    echo "Select prefix:"
    echo "1) FA"
    echo "2) SM"
    echo "3) SP"
    read -p "Enter choice: " choice

    case $choice in
        1) prefix="FA" ;;
        2) prefix="SM" ;;
        3) prefix="SP" ;;
        *) echo "Invalid choice"; exit 1 ;;
    esac

    echo ""
    echo "Using prefix: $prefix"
    echo ""
fi

