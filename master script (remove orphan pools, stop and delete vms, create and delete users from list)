    # REMOVE ORPHAN POOLS
    ###############################################
    if [[ "$confirm_pools" == "DELETE" ]]; then
        echo "=== Removing orphan pools ==="
        for pool in $POOLS; do
            VMCOUNT=$(pvesh get /pools/$pool 2>/dev/null | awk '/vmid/ {count++} END {print count+0}')
            USERCOUNT=$(pvesh get /access/acl -path "/pool/$pool" 2>/dev/null | awk '/users/ {count++} END {print count+0}')

            if [[ "$VMCOUNT" -eq 0 && "$USERCOUNT" -eq 0 ]]; then
                echo "Deleting orphan pool: $pool"
                pvesh delete /pools/$pool >/dev/null 2>&1 && echo "✓ Deleted $pool"
            fi
        done
        echo "=== Orphan pool cleanup complete ==="
