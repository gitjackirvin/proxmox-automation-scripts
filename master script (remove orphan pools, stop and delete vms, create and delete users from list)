    echo "1) FA"
    echo "2) SM"
    echo "3) SP"
    read -p "Enter choices separated by spaces: " choices

    selected_prefixes=()
    for c in $choices; do
        case $c in
            1) selected_prefixes+=("FA") ;;
            2) selected_prefixes+=("SM") ;;
            3) selected_prefixes+=("SP") ;;
            *) echo "Invalid prefix choice: $c"; exit 1 ;;
        esac
    done

    if [[ ${#selected_prefixes[@]} -eq 0 ]]; then
        echo "No prefixes selected. Exiting."
        exit 1
    fi

